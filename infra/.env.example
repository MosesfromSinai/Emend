# Copy to infra/.env (or export in your shell) for local development.

# 1 = deterministic core pipeline, no API key needed (default for local dev)
MOCK=1

# Required only when MOCK=0
ANTHROPIC_API_KEY=

# docker-compose provides these to the api container automatically;
# override only if running the api outside compose.
DATABASE_URL=postgresql+psycopg://emend:emend@localhost:5432/emend
ARTIFACTS_DIR=./artifacts

# Where the web app finds the api
NEXT_PUBLIC_API_URL=http://localhost:8000

# Compile sandbox knobs (defaults are fine)
COMPILE_TIMEOUT_SECONDS=10
# TECTONIC_ONLY_CACHED=1   # set in the Docker image; forces offline compiles
